# Backend API URL
# For local development
VITE_API_URL=http://localhost:8080/api

# For production deployment on same instance:
# Leave this commented out - the app will automatically use relative URLs (/api)
# when built for production, which works perfectly with Nginx reverse proxy

# Only set VITE_API_URL in production if deploying frontend separately:
# VITE_API_URL=http://YOUR-LIGHTSAIL-IP:8080/api
# Or with HTTPS:
# VITE_API_URL=https://yourdomain.com/api
